# 前端资源必须逐字节可复现：网页里引用的行尾不能随 core.autocrlf 变化。
# styles.css / index.html 是 LF，app.js 是 CRLF（与装机版 assets.sha256 一致）。
# 改动这三个文件的行尾会让 APK 里的资源哈希对不上，请不要删掉这几行。
voice-session-fix-20261026/assets/styles.css  text eol=lf
voice-session-fix-20261026/assets/index.html  text eol=lf
voice-session-fix-20261026/assets/js/app.js   text eol=crlf

# 创新版本（innovation/ui-v2）：补丁与冻结基线的行尾同样钉死，否则换台机器重建出来的字节会变。
innovation/ui-v2/orig/styles.css            text eol=lf
innovation/ui-v2/orig/index.html            text eol=lf
innovation/ui-v2/orig/message-workbench.css text eol=lf
innovation/ui-v2/orig/app.js                text eol=crlf
innovation/ui-v2/patches/ui-v2.css          text eol=lf
innovation/ui-v2/patches/kb-stable.js       text eol=lf
innovation/ui-v2/patches/paste-import.js    text eol=lf
innovation/ui-v2/assets.sha256              text eol=lf
# 本机规则的副本：它要被原样 cp 到 .git/info/attributes，行尾一旦变成 CRLF，规则就失效了。
innovation/ui-v2/git-attributes.local       text eol=lf
